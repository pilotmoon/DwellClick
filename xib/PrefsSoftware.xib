                        <font key="font" metaFont="system"/>
                    </buttonCell>
                    <connections>
                        <binding destination="-2" name="value" keyPath="loginController.startAtLogin" id="131"/>
                    </connections>
                </button>
                <button imageHugsTitle="YES" horizontalHuggingPriority="750" verticalHuggingPriority="750" fixedFrame="YES" translatesAutoresizingMaskIntoConstraints="NO" id="154">
                    <rect key="frame" x="458" y="108" width="25" height="25"/>

<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.Cocoa.XIB" version="3.0" toolsVersion="24765" targetRuntime="MacOSX.Cocoa" propertyAccessControl="none" useAutolayout="YES">
    <dependencies>
        <deployment identifier="macosx"/>
        <plugIn identifier="com.apple.InterfaceBuilder.CocoaPlugin" version="24765"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <objects>
        <customObject id="-2" userLabel="File's Owner"/>
        <customObject id="-1" userLabel="First Responder" customClass="FirstResponder"/>
        <customObject id="-3" userLabel="Application" customClass="DCApplication">
            <connections>
                <outlet property="delegate" destination="1" id="2"/>
            </connections>
        </customObject>
        <customObject id="1" customClass="DCAppDelegate">
            <connections>
                <outlet property="menuController" destination="11" id="15"/>
            </connections>
        </customObject>
        <menu id="3">
            <items>
                <menuItem title="Enable DwellClick" id="4">
                    <modifierMask key="keyEquivalentModifierMask"/>
                    <connections>
                        <action selector="onOffMenuItemAction:" target="11" id="80"/>
                    </connections>
                </menuItem>
                <menuItem isSeparatorItem="YES" id="10"/>
                <menuItem title="Preferences..." id="8">
                    <modifierMask key="keyEquivalentModifierMask"/>
                    <connections>
                        <action selector="showPreferences:" target="1" id="17"/>
                    </connections>
                </menuItem>
                <menuItem isSeparatorItem="YES" id="122"/>
                <menuItem title="Buy DwellClick" tag="2" id="45">
                    <modifierMask key="keyEquivalentModifierMask"/>
                    <connections>
                        <action selector="buyButton:" target="11" id="46"/>
                    </connections>
                </menuItem>
                <menuItem isSeparatorItem="YES" tag="1" id="31">
                    <connections>
                        <binding destination="11" name="hidden" keyPath="hideBuyLink" id="75"/>
                    </connections>
                </menuItem>
                <menuItem title="Help" id="50">
                    <modifierMask key="keyEquivalentModifierMask"/>
                    <menu key="submenu" title="Help" id="51">
                        <items>
                            <menuItem title="User Guide" id="58">
                                <modifierMask key="keyEquivalentModifierMask"/>
                                <connections>
                                    <action selector="onlineHelp:" target="11" id="59"/>
                                </connections>
                            </menuItem>
                            <menuItem title="Contact Developer" id="82">
                                <modifierMask key="keyEquivalentModifierMask"/>
                                <connections>
                                    <action selector="sendFeedback:" target="11" id="132"/>
                                </connections>
                            </menuItem>
                        </items>
                    </menu>
                </menuItem>
                <menuItem title="About" id="120">
                    <modifierMask key="keyEquivalentModifierMask"/>
                    <connections>
                        <action selector="showAbout:" target="1" id="121"/>
                    </connections>
                </menuItem>
                <menuItem isSeparatorItem="YES" id="123"/>
                <menuItem title="Quit DwellClick" id="5">
                    <modifierMask key="keyEquivalentModifierMask"/>
                    <connections>
                        <action selector="terminate:" target="-3" id="16"/>
                    </connections>
                </menuItem>
            </items>
            <point key="canvasLocation" x="139" y="151"/>
        </menu>
        <customObject id="11" customClass="DCMainMenuController">
            <connections>
                <outlet property="buyButton" destination="140" id="143"/>
                <outlet property="buyItem" destination="45" id="166"/>
                <outlet property="onOffItem" destination="4" id="81"/>
                <outlet property="statusMenu" destination="3" id="13"/>
            </connections>
        </customObject>
        <userDefaultsController representsSharedInstance="YES" id="20"/>
        <customView id="137">
            <rect key="frame" x="0.0" y="0.0" width="168" height="30"/>
            <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
            <subviews>
                <button imageHugsTitle="YES" verticalHuggingPriority="750" fixedFrame="YES" translatesAutoresizingMaskIntoConstraints="NO" id="138">
                    <rect key="frame" x="33" y="-36" width="96" height="32"/>
                    <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                    <buttonCell key="cell" type="push" title="Button" bezelStyle="rounded" alignment="center" borderStyle="border" imageScaling="proportionallyDown" inset="2" id="139">
                        <behavior key="behavior" pushIn="YES" lightByBackground="YES" lightByGray="YES"/>
                        <font key="font" metaFont="system"/>
                    </buttonCell>
                </button>
                <button imageHugsTitle="YES" fixedFrame="YES" translatesAutoresizingMaskIntoConstraints="NO" id="140" customClass="NMSugarButton">
                    <rect key="frame" x="21" y="3" width="84" height="24"/>
                    <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                    <buttonCell key="cell" type="smallSquare" title="Buy" bezelStyle="smallSquare" imagePosition="overlaps" alignment="center" state="on" borderStyle="border" imageScaling="proportionallyDown" inset="2" id="141" customClass="NMSugarButtonCell">
                        <behavior key="behavior" pushIn="YES" lightByBackground="YES" lightByGray="YES"/>
                        <font key="font" metaFont="system" size="14"/>
                    </buttonCell>
                    <connections>
                        <action selector="buyButton:" target="11" id="142"/>
                    </connections>
                </button>
            </subviews>
        </customView>
    </objects>
</document>
